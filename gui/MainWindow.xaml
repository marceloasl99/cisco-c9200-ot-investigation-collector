<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cisco C9200 OT Investigation Collector" Height="750" Width="1050"
        MinHeight="600" MinWidth="800" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="2"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Top bar: preset selector -->
        <Border DockPanel.Dock="Top" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Label Content="Preset:" VerticalAlignment="Center"/>
                <ComboBox Name="cmbPreset" Width="250" Margin="4,0" VerticalAlignment="Center"/>
                <Button Name="btnSavePreset" Content="Save"/>
                <Button Name="btnSavePresetAs" Content="Save as..."/>
                <Button Name="btnDeletePreset" Content="Delete"/>
                <Label Name="lblPresetModified" Content="(modified)" Foreground="Orange" Visibility="Collapsed" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Tab control -->
        <TabControl Name="tabMain" Margin="4">
            <!-- Targets tab -->
            <TabItem Header="Targets">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Configured switches:" FontWeight="Bold"/>
                    <DataGrid Name="dgSwitches" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" Margin="0,4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="140"/>
                            <DataGridCheckBoxColumn Header="Use" Binding="{Binding Enabled}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4">
                        <Button Name="btnAddSwitch" Content="Add"/>
                        <Button Name="btnRemoveSwitch" Content="Remove"/>
                        <Separator Width="20" Visibility="Hidden"/>
                        <Label Content="Scan range:" VerticalAlignment="Center"/>
                        <TextBox Name="txtScanRange" Width="200" VerticalAlignment="Center" Margin="4,0"/>
                        <Button Name="btnScan" Content="Scan"/>
                    </StackPanel>

                    <ProgressBar Name="pbScan" Grid.Row="3" Height="18" Margin="0,4" Visibility="Collapsed"/>

                    <DataGrid Name="dgScanResults" Grid.Row="4" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" Margin="0,4"
                              Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="130"/>
                            <DataGridTextColumn Header="Ping" Binding="{Binding Ping}" Width="50"/>
                            <DataGridTextColumn Header="TCP/22" Binding="{Binding Tcp}" Width="60"/>
                            <DataGridTextColumn Header="Banner" Binding="{Binding Banner}" Width="200"/>
                            <DataGridTextColumn Header="Cisco" Binding="{Binding Cisco}" Width="50"/>
                            <DataGridCheckBoxColumn Header="Use" Binding="{Binding Use}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Collection tab -->
            <TabItem Header="Collection">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <Label Content="Categories:" FontWeight="Bold"/>
                        <WrapPanel Margin="4">
                            <CheckBox Name="chkIdentity" Content="Identity" IsChecked="True" Margin="0,2,12,2"/>
                            <CheckBox Name="chkHealth" Content="Health" IsChecked="True" Margin="0,2,12,2"/>
                            <CheckBox Name="chkInterfaces" Content="Interfaces" IsChecked="True" Margin="0,2,12,2"/>
                            <CheckBox Name="chkLayer2" Content="Layer2" IsChecked="True" Margin="0,2,12,2"/>
                            <CheckBox Name="chkLayer3" Content="Layer3" IsChecked="True" Margin="0,2,12,2"/>
                            <CheckBox Name="chkSecurity" Content="Security" IsChecked="True" Margin="0,2,12,2"/>
                            <CheckBox Name="chkConfigExtracts" Content="Config Extracts" IsChecked="True" Margin="0,2,12,2"/>
                            <CheckBox Name="chkLogs" Content="Logs" IsChecked="True" Margin="0,2,12,2"/>
                            <CheckBox Name="chkDetailed" Content="Detailed (slow)" Margin="0,2,12,2"/>
                            <CheckBox Name="chkSanitizedConfig" Content="Sanitized Running Config" Margin="0,2,12,2"/>
                        </WrapPanel>

                        <Label Content="Log sources:" FontWeight="Bold" Margin="0,8,0,0"/>
                        <WrapPanel Margin="4">
                            <CheckBox Name="chkLogBuffer" Content="Buffer (show logging)" IsChecked="True" Margin="0,2,12,2"/>
                            <CheckBox Name="chkLogReboot" Content="Reboot history (OBFL)" Margin="0,2,12,2"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="4">
                            <Label Content="Log period:"/>
                            <ComboBox Name="cmbLogDays" Width="120" VerticalAlignment="Center">
                                <ComboBoxItem Content="3 days" Tag="3"/>
                                <ComboBoxItem Content="7 days" Tag="7"/>
                                <ComboBoxItem Content="30 days" Tag="30" IsSelected="True"/>
                                <ComboBoxItem Content="90 days" Tag="90"/>
                                <ComboBoxItem Content="All" Tag="0"/>
                                <ComboBoxItem Content="Custom" Tag="-1"/>
                            </ComboBox>
                            <TextBox Name="txtCustomDays" Width="60" Margin="4,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Label Content="VLANs:" FontWeight="Bold" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <RadioButton Name="rbVlanAll" Content="All" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <RadioButton Name="rbVlanOnly" Content="Only listed:" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Name="txtVlans" Width="250" VerticalAlignment="Center" IsEnabled="False"/>
                        </StackPanel>

                        <Label Content="MAC addresses to trace:" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBox Name="txtMacs" Width="400" HorizontalAlignment="Left" Margin="4,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Connection tab -->
            <TabItem Header="Connection">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Username:"/>
                    <TextBox Name="txtUsername" Grid.Row="0" Grid.Column="1" Margin="4,2"/>

                    <Label Grid.Row="1" Content="Password:"/>
                    <PasswordBox Name="txtPassword" Grid.Row="1" Grid.Column="1" Margin="4,2"/>

                    <Label Grid.Row="2" Content="Plink path:"/>
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="4,2">
                        <Button Name="btnBrowsePlink" Content="Browse" DockPanel.Dock="Right" Margin="4,0,0,0"/>
                        <TextBox Name="txtPlinkPath" />
                    </DockPanel>

                    <Label Grid.Row="3" Content="Plink -pwfile:"/>
                    <Label Name="lblPwFileStatus" Grid.Row="3" Grid.Column="1" Content="(not checked)"/>

                    <Label Grid.Row="4" Content="Max parallel:"/>
                    <TextBox Name="txtMaxParallel" Grid.Row="4" Grid.Column="1" Text="4" Width="60" HorizontalAlignment="Left" Margin="4,2"/>

                    <Label Grid.Row="5" Content="Per-switch timeout (s):"/>
                    <TextBox Name="txtTimeout" Grid.Row="5" Grid.Column="1" Text="175" Width="60" HorizontalAlignment="Left" Margin="4,2"/>

                    <Label Grid.Row="6" Content="SSH connect timeout (s):"/>
                    <TextBox Name="txtConnectTimeout" Grid.Row="6" Grid.Column="1" Text="5" Width="60" HorizontalAlignment="Left" Margin="4,2"/>

                    <Label Grid.Row="7" Content="Host key policy:"/>
                    <ComboBox Name="cmbHostKeyPolicy" Grid.Row="7" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="4,2">
                        <ComboBoxItem Content="AutoAccept" IsSelected="True"/>
                        <ComboBoxItem Content="Strict"/>
                    </ComboBox>

                    <Label Grid.Row="8" Content="Report directory:"/>
                    <DockPanel Grid.Row="8" Grid.Column="1" Margin="4,2">
                        <Button Name="btnBrowseReport" Content="Browse" DockPanel.Dock="Right" Margin="4,0,0,0"/>
                        <TextBox Name="txtReportDir"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Run & Monitor tab -->
            <TabItem Header="Run &amp; Monitor">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Name="btnStart" Content="Start" FontWeight="Bold"/>
                        <Button Name="btnCancel" Content="Cancel" IsEnabled="False"/>
                        <Button Name="btnOpenReport" Content="Open report" IsEnabled="False"/>
                        <Button Name="btnOpenFolder" Content="Open folder"/>
                        <Separator Width="20" Visibility="Hidden"/>
                        <Label Name="lblRunStatus" Content="Ready" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ProgressBar Name="pbRun" DockPanel.Dock="Top" Height="20" Margin="0,0,0,4"/>

                    <DataGrid Name="dgRunProgress" DockPanel.Dock="Top" Height="200"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="True" Margin="0,0,0,4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Switch" Binding="{Binding Name}" Width="120"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="130"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Step" Binding="{Binding Step}" Width="200"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="60"/>
                            <DataGridTextColumn Header="KB" Binding="{Binding KB}" Width="60"/>
                            <DataGridTextColumn Header="Logs" Binding="{Binding Logs}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Label DockPanel.Dock="Top" Content="Event log:" FontWeight="Bold"/>
                    <TextBox Name="txtEventLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                             Background="#1E1E1E" Foreground="#D4D4D4"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
