# User settings (contains saved preferences, never credentials)
settings.json

# Host key store (auto-populated by TOFU)
known_hosts.json

# Reports generated by the collector
Cisco_C9200_OT_Investigation_*.txt

# PuTTY binary (user-supplied, not distributed)
plink.exe

# Superpowers workspace
.superpowers/

# PowerShell module cache
PSModulePath/
